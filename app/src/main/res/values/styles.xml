<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget 基样式：所有 Widget.XXX 子样式的前缀基类 -->
    <style name="Widget" parent="" />

    <!-- 录制页快捷开关 chip -->
    <style name="Widget.SettingsChip" parent="Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <!-- 设置页 chip 样式 -->
    <style name="Widget.SettingsChip.Small" parent="Widget.SettingsChip">
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:layout_marginEnd">6dp</item>
    </style>

    <!-- ===== 设置页通用组件 ===== -->
    <style name="Widget.SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Widget.SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_surface</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Widget.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/bg_row_divider</item>
    </style>

    <style name="Widget.RowIcon">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:background">@drawable/bg_surface_3</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>

    <style name="Widget.RowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.RowTextStack">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Widget.RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>

    <style name="Widget.RowValueMono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Widget.RowSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.ChipGroup">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.RowSlider">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:valueFrom">0</item>
        <item name="android:valueTo">100</item>
        <item name="android:stepSize">1</item>
    </style>

    <style name="Widget.SliderValue">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Widget.AddButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip_active</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Widget.StatusBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_status_success</item>
        <item name="android:textColor">@color/state_success</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:text">@string/granted</item>
    </style>

    <!-- ===== 文件页组件 ===== -->
    <style name="Widget.StatDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@color/line</item>
    </style>

    <style name="Widget.FilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="Widget.SheetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.SheetRow.Item">
        <item name="android:drawableTint">@color/ink_2</item>
    </style>

    <!-- ===== 设计稿 Recorder 样式族 ===== -->
    <style name="Widget.Recorder.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line</item>
    </style>

    <style name="Widget.Recorder.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Recorder.Chip.Active" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/brand</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <style name="Widget.Recorder.Chip.Inactive" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/surface_2</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <style name="TextAppearance.Recorder.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Recorder.SectionLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TextAppearance.Recorder.Timer">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>