<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ========== 1. 相机预览区（16:9） ========== -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintDimensionRatio="h,16:9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 状态显示覆盖层（模式1） -->
        <LinearLayout
            android:id="@+id/statusOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/bg"
            android:visibility="gone"
            tools:visibility="visible">
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/idle"
                android:textColor="@color/ink_2"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 空白覆盖层（模式2） -->
        <View
            android:id="@+id/blankOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:visibility="gone" />

        <!-- 左上：录制状态徽标 -->
        <LinearLayout
            android:id="@+id/recBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="#99000000"
            android:visibility="gone"
            tools:visibility="visible">
            <View
                android:id="@+id/recDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_rec_dot" />
            <TextView
                android:id="@+id/recBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recording"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- 右上：切换摄像头 -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_switch_camera"
            android:contentDescription="@string/switch_camera"
            android:background="#99000000"
            android:padding="9dp" />

        <!-- 左下：美颜入口 -->
        <TextView
            android:id="@+id/btnBeauty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/ic_sparkles"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/beauty"
            android:textColor="@color/brand"
            android:textSize="12sp"
            android:background="@drawable/bg_chip_active" />

        <!-- 右下：闪光灯 -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_flash_off"
            android:contentDescription="@string/flash"
            android:background="#99000000"
            android:padding="9dp" />

        <!-- 中下：实时参数 -->
        <TextView
            android:id="@+id/tvParams"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="#66000000"
            android:text="1080p · 30fps"
            android:fontFamily="monospace"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- ========== 2. 录制信息栏 ========== -->
    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/previewContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:fontFamily="monospace"
                android:textColor="@color/ink"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 MB"
                android:fontFamily="monospace"
                android:textColor="@color/ink_2"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink_3"
            android:textSize="12sp"
            tools:text="剩余空间 6.2 GB" />
    </LinearLayout>

    <!-- ========== 3. 录制控件 ========== -->
    <LinearLayout
        android:id="@+id/controlsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/infoBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 暂停/继续 -->
        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="40dp"
            android:src="@drawable/ic_pause"
            android:contentDescription="@string/pause_resume"
            android:background="@drawable/bg_surface_3"
            android:padding="14dp" />

        <!-- 主录制按钮 + 脉冲环 -->
        <FrameLayout
            android:id="@+id/recordBtnWrap"
            android:layout_width="72dp"
            android:layout_height="72dp">
            <View
                android:id="@+id/recordPulseRing"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_record_button"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_record_square"
                android:contentDescription="@string/tap_to_start"
                android:background="@drawable/bg_record_button"
                android:padding="18dp" />
        </FrameLayout>

        <!-- 截图 -->
        <ImageButton
            android:id="@+id/btnScreenshot"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="40dp"
            android:src="@drawable/ic_row_camera"
            android:contentDescription="@string/screenshot"
            android:background="@drawable/bg_surface_3"
            android:padding="14dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTapHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/tap_to_start"
        android:textColor="@color/ink_2"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/controlsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== 4. 快捷开关 ========== -->
    <LinearLayout
        android:id="@+id/togglesRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvTapHint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/toggleFloat"
            style="@style/Widget.SettingsChip"
            android:text="@string/floating_window" />
        <TextView
            android:id="@+id/toggleAudio"
            style="@style/Widget.SettingsChip"
            android:text="@string/internal_audio" />
        <TextView
            android:id="@+id/toggleBeauty"
            style="@style/Widget.SettingsChip"
            android:text="@string/beauty" />
        <TextView
            android:id="@+id/toggleTimer"
            style="@style/Widget.SettingsChip"
            android:text="@string/timer" />
        <TextView
            android:id="@+id/toggleTouch"
            style="@style/Widget.SettingsChip"
            android:text="@string/anti_touch" />
    </LinearLayout>

    <!-- ========== 5. 录制统计 ========== -->
    <LinearLayout
        android:id="@+id/statsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_surface"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/togglesRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvRecordCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/record_count"
                android:textColor="@color/ink_2"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/line">
            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0h"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/total_duration"
                android:textColor="@color/ink_2"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvStorageUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 MB"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/storage_used"
                android:textColor="@color/ink_2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>